# n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme
GENERIC_TIMEZONE=Asia/Jerusalem
N8N_RUNNERS_AUTH_TOKEN=change-this-to-a-random-secret

# Gemini
GEMINI_API_KEY=your-key-here

# OpenAI (used by FastAPI enrichment API for sensitivity verification)
OPENAI_API_KEY=your-openai-key-here

# Notifications — comma-separated list of recipients
NOTIFY_EMAIL=you@example.com,other@example.com

# Dashboard (served on port 3000)
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SHEETS_API_KEY=your-restricted-google-sheets-api-key
DASHBOARD_WEBHOOK_URL=http://localhost:5678/webhook/prismatic-rag-chat


